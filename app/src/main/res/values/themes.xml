    <color name="oneui_primary_dark">#0072DE</color>
    <color name="oneui_background">#FAFAFA</color>
    <color name="oneui_surface">#FFFFFF</color>
    <color name="oneui_on_surface">#000000</color>
    <color name="oneui_on_surface_variant">#555555</color>

    <style name="Theme.Toktok" parent="Theme.Material3.Light.NoActionBar">
